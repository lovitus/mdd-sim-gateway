{
  "name": "mdd-sim-gateway-webui",
  "private": true,
  "version": "1.3.13",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:go": "vite build --outDir .go-dist && node scripts/embed-go-ui.mjs .go-dist --clean",
    "preview": "vite preview",
    "test:agent-health": "node tests/agentHealthPresentation.mjs",
    "test:live-status": "node tests/liveStatus.mjs",
    "test:control-ws": "node tests/controlWebSocket.mjs",
    "test:cellular-incoming": "node tests/cellularIncomingCoordinator.mjs",
    "test:cellular-browser": "node tests/cellularBrowserCall.mjs",
    "test:browser-pcm": "node tests/browserMediaPcm.mjs",
    "test:vowifi-incoming": "node tests/vowifiIncomingFallback.mjs",
    "test:line-presentation": "node tests/linePresentation.mjs",
    "test:cellular-media": "node tests/cellularMediaMonitor.mjs",
    "test:sms-submission": "node tests/smsSubmissionSafety.mjs",
    "test:vowifi-media": "node tests/vowifiMediaGate.mjs",
    "test:vowifi-media-behavior": "node tests/vowifiMediaBehavior.mjs",
    "test:native-browser-call": "node tests/nativeBrowserCall.mjs",
    "test:native-browser-incoming": "node tests/nativeBrowserIncoming.mjs",
    "test:native-incoming-coordinator": "node tests/nativeIncomingCoordinator.mjs",
    "test:request-coalescing": "node tests/requestCoalescing.mjs",
    "test:update-progress": "node tests/updateProgress.mjs",
    "test:toast": "node tests/toastLifecycle.mjs",
    "test:go-v1-adapter": "node tests/goV1Adapter.mjs",
    "test:all": "npm run test:go-v1-adapter && npm run test:agent-health && npm run test:live-status && npm run test:control-ws && npm run test:cellular-incoming && npm run test:cellular-browser && npm run test:browser-pcm && npm run test:vowifi-incoming && npm run test:line-presentation && npm run test:cellular-media && npm run test:sms-submission && npm run test:vowifi-media && npm run test:vowifi-media-behavior && npm run test:native-browser-call && npm run test:native-browser-incoming && npm run test:native-incoming-coordinator && npm run test:request-coalescing && npm run test:update-progress && npm run test:toast"
  },
  "dependencies": {
    "jsqr": "^1.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.3.3",
    "vite": "^6.0.7"
  }
