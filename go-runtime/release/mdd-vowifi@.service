[Unit]
Description=MDD native VoWiFi provider for %i
After=network-online.target mdd-core.service
Wants=network-online.target

[Service]
Type=simple
User=mdd
Group=mdd
StartLimitInterval=300
StartLimitBurst=5
ExecStart=/usr/libexec/mdd/mdd-vowifi -config /etc/mdd/providers-current/%i.json
Restart=on-failure
RestartSec=10s
TimeoutStopSec=15s
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
