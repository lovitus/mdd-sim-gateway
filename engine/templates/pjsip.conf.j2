[global]
type=global
allow_sending_180_after_183=yes
user_agent={{ user_agent }}

[system]
type=system
timer_t1=2000
; Timer B must be at least 64 * Timer T1. State the effective value explicitly instead of
; making pjproject correct it at every startup and emit a misleading warning.
timer_b=128000

; ================= VoLTE / VoWiFi IMS core transport (over the ePDG tunnel) =================
[volte_ims]
type=transport
protocol=tcp
{% if pcscf_is_v6 %}
bind=[::]:5060
{% else %}
bind=0.0.0.0:5060
{% endif %}
bind_interface=ipsec0
sec_port_c_min=40000
sec_port_c_max=44999
sec_port_s_min=50000
sec_port_s_max=54999
{% if pani %}
p_access_network_info={{ pani }}
{% endif %}
sec_encryption=yes

{% if pcscf %}
[volte_ims]
type=registration
transport=volte_ims
outbound_auth=volte_ims
imei={{ imei }}
{% if access_type %}
accesstype={{ access_type }}
{% endif %}
server_uri=sip:{{ realm }}
client_uri=sip:{{ imsi }}@{{ realm }}
retry_interval=30
; A fatal carrier/configuration rejection is not repaired by rebuilding the same Engine or
; hammering REGISTER every 30 seconds.  Keep transport/no-response retries responsive above,
; but pace explicit fatal responses until an operator/config change or the hourly probe.
fatal_retry_interval=3600
max_retries=999999999
expiration=600000
volte=yes
manual_register=yes
endpoint=volte_ims
receive_sms=yes

[volte_ims]
type=endpoint
; Carrier-specific: O2 UK requires ;user=phone on originating telephone-number INVITEs, while
; Telus' SMSC rejects MESSAGE request-URIs carrying it. The control-plane config selects this.
user_eq_phone={{ 'yes' if user_eq_phone else 'no' }}
transport=volte_ims
context=volte_ims
message_context=volte_ims_msg
disallow=all
allow=amr
bw_value=41
outbound_auth=volte_ims
aors=volte_ims
rewrite_contact=yes
from_domain={{ realm }}
from_user={{ msisdn }}
trust_id_outbound=yes
send_pai=yes
send_rpid=no
callerid={{ msisdn }}
volte=yes
dedicated_bearer_up=yes
100rel=peer_supported
moh_passthrough=yes
direct_media=no
smsc_uri=sip:{{ smsc }}@{{ realm }}
sdp_owner={{ sdp_owner }}
sdp_session={{ sdp_session }}

[volte_ims]
type=auth
auth_type=ims_aka
username={{ imsi }}@{{ realm }}
usim_ami=yes

[volte_ims]
type=aor
contact=sip:{{ imsi }}@{{ realm }}
max_contacts=1

[volte_ims]
type=identify
endpoint=volte_ims
match={{ pcscf }}

[{{ realm }}]
type=resolve
ip={{ pcscf }}
transport=volte_ims

[smsoip.{{ realm }}]
type=resolve
ip={{ pcscf }}
transport=volte_ims
{% endif %}

; ================= Authenticated browser softphone =================
{# Keep the Engine's private identity here.  The authenticated Control WSS bridge translates
   SDP/ICE per browser session; a global external address would make the first NIC selected win
   for every user and would reintroduce the multi-NIC/VPN failure this design removes. #}
{% if webrtc_enable %}
; WebRTC (wss) rides on the built-in HTTP/TLS server configured in http.conf.
; bind is still REQUIRED (transport_apply rejects the object without it) even though
; the actual listener is http.conf's tlsbindaddr; without it the transport object is
; never created and any INVITE on the webrtc endpoint dies with 500
; ("Unable to retrieve PJSIP transport 'transport-wss'").
[transport-ws]
type=transport
protocol=ws
bind=0.0.0.0

[transport-wss]
type=transport
protocol=wss
bind=0.0.0.0
{% endif %}

[endpoint-local](!)
type=endpoint
context=from-local
message_context=msg-from-local
; from_domain gives the From/PAI URI a valid host on the INVITE Asterisk sends to a local client
; (WebRTC softphone). Without it Asterisk defaults the From domain to the container
; HOSTNAME (a docker id like 03e373936eb4), which JsSIP's strict SIP parser rejects ("error parsing
; From header") — it drops the whole INVITE, so newRTCSession never fires and the browser softphone
; shows no incoming-call (Answer/Decline) overlay. The IMS realm is always a valid FQDN.
from_domain={{ realm }}
disallow=all
allow=amr
allow=ulaw
allow=alaw
allow=opus
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes
; Never let the WebRTC softphone direct-media with the IMS side:
; the two legs are incompatible (DTLS-SRTP + opus/ulaw on the client vs plain RTP + AMR on
; the carrier), so Asterisk MUST stay in the media path to bridge/transcode. With direct_media
; left on (the default) Asterisk would try to re-INVITE the two ends to talk directly, which
; can't work → no audio. (volte_ims already has direct_media=no.)
direct_media=no
; Browser REFER/transfer could create a new from-local numeric dialog without traversing the
; Control WS admission that proves fresh media. Transfers remain disabled until they have an
; equally strict, per-dialog server-side admission.
allow_transfer=no
; Bound the browser media leg after tab/network loss.  This applies only to the local WebRTC
; endpoint; IMS registration and the carrier endpoint retain their own timers.
rtp_timeout=10
rtp_timeout_hold=10
{% if msisdn %}
callerid=undefined <{{ msisdn }}>
{% endif %}

[auth-local](!)
type=auth
auth_type=userpass

[aor-local](!)
type=aor
max_contacts=3
remove_existing=yes

{% if webrtc_enable %}
[{{ webrtc_user }}](endpoint-local)
; Cached legacy SIP credentials never enter native call or outbound MESSAGE contexts.
context=from-webrtc
message_context=from-webrtc
auth=auth-{{ webrtc_user }}
aors={{ webrtc_user }}
transport=transport-wss
webrtc=yes
dtls_auto_generate_cert=yes
[auth-{{ webrtc_user }}](auth-local)
username={{ webrtc_user }}
password={{ webrtc_password }}
[{{ webrtc_user }}](aor-local)
{% endif %}
