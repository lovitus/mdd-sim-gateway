{% set local_eps = [] %}
{% if webrtc_enable %}{% set _ = local_eps.append('PJSIP/' ~ webrtc_user) %}{% endif %}
{% set dialstr = local_eps | join('&') %}
{% set msg_targets = [] %}
{% if webrtc_enable %}{% set _ = msg_targets.append(webrtc_user) %}{% endif %}
{# Match every non-empty printable extension without Asterisk's noisy bare `_.` wildcard.
   The leading ASCII character set preserves UUID/GRUU, SIP/TEL and short-code users; the
   trailing `!` allows the original one-character minimum and is safe in these request-driven
   SIP contexts (there is no overlap-dial digit collection here). #}
{% set any_extension = '_[!-~]!' %}

; ===== Incoming call from the IMS/VoWiFi side =====
[volte_ims]
; MUST match any non-empty printable user: the IMS routes inbound calls to our REGISTERED CONTACT, whose
; user part is a random GRUU/UUID (e.g. ef666c87-...@[v6]:port), NOT a phone number — so a
; numeric-only pattern like _[+0-9]. never matches and every incoming call is 404-rejected.
; The explicit h/i/t handlers below take precedence over the catch-all, so no phantom "call to h" is
; logged (that was the original reason _. had been narrowed).
exten => {{ any_extension }},1,Set(GROUP(mdd_line_call)=active)
same => n,Set(MDD_LINE_CALL_COUNT=${GROUP_COUNT(active@mdd_line_call)})
same => n,GotoIf($[${MDD_LINE_CALL_COUNT} != 1]?line-busy)
same => n,Set(MDD_LINE_CALL_CLAIM=1)
same => n,NoOp(Incoming call from ${CALLERID(num)})
; This is the process-local final admission barrier. It remains effective if Control callbacks
; are delayed or Control is restarting, and it does not intercept SIP BYE/CANCEL/re-INVITE.
same => n,GotoIf($[${STAT(e,/run/mdd-sim-gateway/engine-maintenance.json)}]?rebind-blocked)
same => n,GotoIf($[${STAT(e,/run/mdd-sim-gateway/pcscf-rebind.json)}]?rebind-blocked)
same => n,GotoIf($["${MDD_ADMISSION(call_in)}" != "ALLOW"]?rebind-blocked)
same => n,Set(MDD_CALL_ADMITTED=1)
same => n,Set(CALLPEER=${CALLERID(num)})
same => n,Set(DIALSTATUS=NOANSWER)
same => n,Set(MDD_INBOUND_ANSWER_RESULT=waiting)
; One hangup handler stays attached to this IMS channel across Control's fixed Redirect and
; Bridge(n).  No context-specific h extension may emit a duplicate result.
same => n,Set(CHANNEL(hangup_handler_push)=mdd-inbound-result,s,1)
same => n,Progress()
same => n,Set(FILE(/logs/calls.txt,,,a)=IN call from ${CALLERID(num)} at ${STRFTIME(${EPOCH},,%Y-%m-%d %H:%M:%S)})
same => n,TrySystem(python3 /usr/local/bin/notify.py call_in --call-id "${CHANNEL(linkedid)}" --arg64 "${BASE64_ENCODE(${CALLERID(num)})}" &)
same => n,WaitForPrecondition(10,2000)
same => n,Ringing()
; The native B path keeps IMS unanswered while authenticated pages independently warm their
; media WSS.  The winning page is attached through browser-media-inbound-attach below.
same => n,Set(TIMEOUT(absolute)=65)
same => n,Wait(60)
same => n,Hangup()
same => n(rebind-blocked),Hangup(41)
same => n(line-busy),Hangup(17)
; i (invalid) / t (response timeout) are explicit no-ops so the catch-all never mislogs them.
exten => i,1,Hangup()
exten => t,1,Hangup()
; Keep h explicit so the printable catch-all cannot treat hangup as another inbound request.
; The pushed mdd-inbound-result handler is the sole result emitter.
exten => h,1,Return()

[mdd-inbound-result]
; DIALSTATUS starts NOANSWER, the exact Control reject path writes BUSY, and only the bridged
; Answer callback writes ANSWER after ast_raw_answer() and an IMS-Up recheck.
exten => s,1,ExecIf($["${MDD_CALL_ADMITTED}" = "1"]?TrySystem(python3 /usr/local/bin/notify.py call_result --call-id "${CHANNEL(linkedid)}" --arg64 "${BASE64_ENCODE(in)}" --arg64 "${BASE64_ENCODE(${CALLPEER})}" --arg64 "${BASE64_ENCODE(${DIALSTATUS})}" --arg64 "${BASE64_ENCODE(${HANGUPCAUSE})}" &))
same => n,Return()

; ===== Incoming SMS from the IMS/VoWiFi side =====
[volte_ims_msg]
exten => {{ any_extension }},1,NoOp(Incoming SMS from ${MESSAGE(from)})
; The patched PJSIP MESSAGE handler is the single MT admission/ack linearization point. Once it
; returns 200 and emits RP-ACK this queued message must be consumed exactly once even if the
; short authority lease expires before the dialplan runs.
same => n,Set(NL=${BASE64_DECODE(Cg==)})
same => n,Set(FILE(/logs/messages.txt,,,a)=IN SMS from ${MESSAGE(from)} at ${STRFTIME(${EPOCH},,%Y-%m-%d %H:%M:%S)}:${NL}${MESSAGE(body)}${NL}=====${NL})
same => n,TrySystem(python3 /usr/local/bin/notify.py sms_in --arg64 "${BASE64_ENCODE(${MESSAGE(from)})}" --arg64 "${BASE64_ENCODE(${BASE64_ENCODE(${MESSAGE(body)})})}" &)
{% for t in msg_targets %}
same => n,MessageSend(pjsip:{{ t }},${MESSAGE(from)},sip:{{ t }})
{% endfor %}
same => n,Hangup()

; ===== Outgoing call from the authenticated browser softphone =====
; Single dial attempt (no auto-redial). The dial result (incl. far-end reject) is
; reported to the manager for the call log.
[browser-media-canary]
; Fixed non-billable path for Browser -> Control WSS -> native Asterisk media WebSocket. This
; context intentionally has no include and no carrier, REGISTER, SMS or APDU application.
exten => echo,1,NoOp(Same-origin WSS browser media canary)
; MDD_ADMISSION synchronously checks both local maintenance markers and the current authority.
; Unlike escalating STAT(), it remains valid on a configured outbound WebSocket channel while
; asterisk.conf keeps live_dangerously=no.
same => n,GotoIf($["${MDD_ADMISSION(media_check)}" != "ALLOW"]?rebind-blocked)
same => n,Set(TIMEOUT(absolute)=10)
same => n,Echo()
same => n,Hangup()
same => n(rebind-blocked),Hangup(41)

[browser-media-outbound-warmup]
; Priority 1 first joins the per-line channel group, then admits only a total count of one. Two
; simultaneous claimants may both fail closed, but can never both win. The same WebSocket channel
; retains membership across Redirect and Asterisk removes it automatically on channel destruction.
exten => echo,1,Set(GROUP(mdd_line_call)=active)
same => n,Set(MDD_LINE_CALL_COUNT=${GROUP_COUNT(active@mdd_line_call)})
same => n,GotoIf($[${MDD_LINE_CALL_COUNT} != 1]?line-busy)
same => n,Set(MDD_LINE_CALL_CLAIM=1)
same => n,GotoIf($["${MDD_ADMISSION(media_check)}" != "ALLOW"]?rebind-blocked)
same => n,Set(TIMEOUT(absolute)=10)
same => n,Echo()
same => n,Hangup()
same => n(rebind-blocked),Hangup(41)
same => n(line-busy),Hangup(17)

[browser-media-outbound]
; This fixed Redirect target accepts no browser-controlled dialplan location.  Every value is
; written and read back over the exact one-shot AMI socket before the single Redirect submit.
exten => call,1,GotoIf($["${MDD_LINE_CALL_CLAIM}" != "1"]?invalid)
same => n,GotoIf($["${GROUP(mdd_line_call)}" != "active"]?invalid)
same => n,GotoIf($["${MDD_NATIVE_CALL}" != "1"]?invalid)
same => n,GotoIf($[!${REGEX("^[A-Za-z0-9_-]{32,128}$" ${MDD_MEDIA_TOKEN})}]?invalid)
same => n,GotoIf($[!${REGEX("^[A-Za-z0-9_-]{20,64}$" ${MDD_MEDIA_EPOCH})}]?invalid)
same => n,GotoIf($[!${REGEX("^[0-9a-f]{32}$" ${MDD_OPERATION_ID})}]?invalid)
same => n,Set(MDD_DESTINATION_FILTERED=${FILTER(0-9+,${MDD_DESTINATION})})
same => n,GotoIf($["${MDD_DESTINATION_FILTERED}" != "${MDD_DESTINATION}"]?invalid)
same => n,Set(MDD_DESTINATION_LENGTH=${LEN(${MDD_DESTINATION})})
same => n,GotoIf($[${MDD_DESTINATION_LENGTH} >= 2 & ${MDD_DESTINATION_LENGTH} <= 6 & ${REGEX("^[0-9]+$" ${MDD_DESTINATION})}]?destination-ok)
same => n,GotoIf($[${MDD_DESTINATION_LENGTH} >= 8 & ${MDD_DESTINATION_LENGTH} <= 16 & ${REGEX("^\\+[1-9][0-9]+$" ${MDD_DESTINATION})}]?destination-ok:invalid)
same => n(destination-ok),Goto(from-local,${MDD_DESTINATION},1)
same => n(invalid),Hangup(21)

[browser-media-inbound-attach]
; Control has written and read back every field on both exact channels before the sole fixed
; Redirect.  No page can choose this context, its priority, or the Bridge application options.
exten => s,1,GotoIf($["${MDD_INBOUND_ATTACH}" != "1"]?invalid)
same => n,GotoIf($["${MDD_INBOUND_SOURCE_ID}" != "${CHANNEL(uniqueid)}"]?invalid)
same => n,GotoIf($[!${REGEX("^[0-9a-f]{32}$" ${MDD_INBOUND_OPERATION})}]?invalid)
same => n,GotoIf($[!${REGEX("^[A-Za-z0-9_-]{20,64}$" ${MDD_MEDIA_EPOCH})}]?invalid)
same => n,GotoIf($[!${REGEX("^mddcanary-[0-9A-Fa-f-]{36}$" ${MDD_INBOUND_WINNER_ID})}]?invalid)
same => n,GotoIf($[!${REGEX("^WebSocket/mdd_control_media/0x[0-9A-Fa-f]+$" ${MDD_INBOUND_WINNER_CHANNEL})}]?invalid)
; Final process-local fence immediately before attach. MddAnswerBridged repeats call_in admission
; both before queue and again at the callback Answer linearization point.
same => n,GotoIf($["${MDD_ADMISSION(media_check)}" != "ALLOW"]?rebind-blocked)
same => n,Set(TIMEOUT(absolute)=10)
same => n,Bridge(${MDD_INBOUND_WINNER_CHANNEL},n)
same => n,Hangup()
same => n(invalid),Hangup(21)
same => n(rebind-blocked),Hangup(41)

[from-local]
; Non-billable browser-media canary. The WebUI calls this first and requires fresh outbound
; and echoed inbound RTP before it is allowed to originate a carrier INVITE below.
exten => mdd-media-check,1,NoOp(Browser media canary)
same => n,GotoIf($["${MDD_ADMISSION(media_check)}" != "ALLOW"]?rebind-blocked)
same => n,Answer()
same => n,Set(MDD_MEDIA_TOKEN=${PJSIP_HEADER(read,X-MDD-Media-Token)})
same => n,TrySystem(python3 /usr/local/bin/notify.py media_check --call-id "${CHANNEL(uniqueid)}" --arg64 "${BASE64_ENCODE(${MDD_MEDIA_TOKEN})}" &)
same => n,Echo()
same => n,Hangup()
same => n(rebind-blocked),Hangup(41)
; _[+0-9]. (not _.) so the special h/i/t extensions never match here and log phantom calls
exten => _[+0-9].,1,GotoIf($["${MDD_NATIVE_CALL}" != "1"]?native-required)
same => n,GotoIf($["${MDD_LINE_CALL_CLAIM}" != "1"]?native-required)
same => n,NoOp(Outgoing call to ${EXTEN} from ${CALLERID(num)})
same => n,GotoIf($["${MDD_ADMISSION(call_out)}" != "ALLOW"]?rebind-blocked)
same => n,Set(MDD_CALL_ADMITTED=1)
same => n,Set(CALLPEER=${EXTEN})
; Bind the carrier leg to Control's one-shot browser admission. If that exact WSS disappears,
; Control can terminate this channel after the 10-second grace without touching another call.
; Process-independent paid-call safety lease. Control renews this exact browser channel while
; its owning WSS is alive; a Control crash or lost WSS therefore hangs up locally within 10s.
same => n,Set(MDD_SOURCE_CALL_ID=${CHANNEL(uniqueid)})
same => n,Set(TIMEOUT(absolute)=10)
same => n,GotoIf($["${MDD_NATIVE_CALL}" = "1"]?notify-call-out)
same => n,Set(FILE(/logs/calls.txt,,,a)=OUT call to ${EXTEN} at ${STRFTIME(${EPOCH},,%Y-%m-%d %H:%M:%S)})
same => n(notify-call-out),NoOp(Native call event uses the structured Engine hook)
same => n,TrySystem(python3 /usr/local/bin/notify.py call_out --call-id "${MDD_SOURCE_CALL_ID}" --arg64 "${BASE64_ENCODE(${EXTEN})}" --arg64 "${BASE64_ENCODE(${MDD_MEDIA_TOKEN})}" &)
; Ring timeout {{ ring_timeout }}s (configurable): if the callee never answers, Asterisk
; CANCELs the outbound INVITE at this deadline instead of leaving it open. The carrier keeps
; the early dialog alive and RE-ALERTS the callee (repeated 180 Ringing) for as long as our
; INVITE is pending, so a shorter timeout bounds how many ring cycles the callee gets before
; we give up. Most carriers roll to voicemail by ~30s; 35 is the default. (The repeated
; ringing itself is carrier-side MMTel behaviour and can't be removed here.) A caller who
; hangs up earlier still CANCELs immediately.
; A 3GPP UE must select one of its registered public identities when originating
; a session. O2 UK otherwise accepts the INVITE at the P-CSCF (100 Trying) but
; has the TAS terminate it immediately with 487 Request Terminated.
same => n,Dial(PJSIP/${EXTEN}@volte_ims,{{ ring_timeout }},b(ims-outbound-headers^s^1)U(mdd-call-active^${MDD_SOURCE_CALL_ID}^${MDD_MEDIA_TOKEN}^${CALLPEER}))
; Dial only returns here when the call was NEVER answered (reject/busy/no-answer/congestion);
; answered calls are bridged and tear down via BYE, never reaching this line.
; Save the REAL disposition for the call log BEFORE overriding the response (PJSIPHangup does
; not clobber HANGUPCAUSE, but Set them first so the 'h' handler is order-independent).
same => n,Set(REALSTATUS=${DIALSTATUS})
same => n,Set(REALCAUSE=${HANGUPCAUSE})
; CRITICAL: on a rejected/unavailable call the carrier (Telus IMS) returns "480 Temporarily
; Unavailable", which Asterisk forwards to the local caller. 480 is a RETRYABLE response
; (RFC 3261 §21.4.11), so MicroSIP auto-redials forever and JsSIP hangs. Force a clean,
; non-retryable "603 Decline" to the caller instead so the client stops and shows the call as
; ended/declined. (ANSWER never reaches here; the guard is belt-and-suspenders.)
same => n,ExecIf($["${DIALSTATUS}" != "ANSWER" & "${MDD_NATIVE_CALL}" != "1"]?PJSIPHangup(Decline))
same => n,Hangup()
same => n(rebind-blocked),Hangup(41)
same => n(native-required),Hangup(21)
; Report the outcome from the hangup handler, NOT inline after Dial(): when the caller
; (softphone) hangs up mid-ring, the caller channel is destroyed and jumps straight to 'h',
; so an inline call_result would never run and the record would stay stuck on "dialing".
; Use REALSTATUS/REALCAUSE (captured right after Dial) so the log keeps the TRUE far-end
; disposition (e.g. CHANUNAVAIL/31) rather than the overridden Decline; fall back to the live
; vars when REAL* are unset (caller hung up mid-ring → jumped straight to 'h' before Set).
exten => h,1,Set(ST=${IF($["${REALSTATUS}" != ""]?${REALSTATUS}:${DIALSTATUS})})
same => n,Set(CS=${IF($["${REALCAUSE}" != ""]?${REALCAUSE}:${HANGUPCAUSE})})
same => n,ExecIf($["${MDD_CALL_ADMITTED}" = "1"]?TrySystem(python3 /usr/local/bin/notify.py call_result --call-id "${MDD_SOURCE_CALL_ID}" --arg64 "${BASE64_ENCODE(out)}" --arg64 "${BASE64_ENCODE(${CALLPEER})}" --arg64 "${BASE64_ENCODE(${ST})}" --arg64 "${BASE64_ENCODE(${CS})}" --arg64 "${BASE64_ENCODE(${MDD_MEDIA_TOKEN})}" &))
same => n,Hangup()

[mdd-call-active]
exten => s,1,TrySystem(python3 /usr/local/bin/notify.py call_active --call-id "${ARG1}" --arg64 "${BASE64_ENCODE(${ARG3})}" --arg64 "${BASE64_ENCODE(${ARG2})}" &)
same => n,Return()

[ims-outbound-headers]
exten => s,1,Set(CALLERID(all)={{ msisdn }} <{{ msisdn }}>)
same => n,Set(CALLERID(pres)=allowed_not_screened)
same => n,Set(PJSIP_HEADER(add,P-Preferred-Identity)=<tel:{{ msisdn }}>)
same => n,Return()

; ===== Outgoing SMS from a local endpoint =====
[msg-from-local]
exten => {{ any_extension }},1,NoOp(Outgoing SMS to ${MESSAGE(to)})
same => n,GotoIf($[${STAT(e,/run/mdd-sim-gateway/engine-maintenance.json)}]?rebind-blocked)
same => n,GotoIf($[${STAT(e,/run/mdd-sim-gateway/pcscf-rebind.json)}]?rebind-blocked)
same => n,GotoIf($["${MDD_ADMISSION(sms_out)}" != "ALLOW"]?rebind-blocked)
same => n,Set(NL=${BASE64_DECODE(Cg==)})
same => n,Set(EXTEN=${CUT(CUT(MESSAGE(to),@,1),:,2)})
; res_pjsip_messaging performs the final admission check immediately before serializer submit.
; Only a confirmed submit may create success history or notify users.
same => n,MessageSend(pjsip:volte_ims/${EXTEN}@volte_ims,sip:{{ msisdn }}@{{ realm }},sip:${EXTEN}@volte_ims)
same => n,GotoIf($["${MESSAGE_SEND_STATUS}" != "SUCCESS"]?send-failed)
same => n,Set(FILE(/logs/messages.txt,,,a)=OUT SMS to ${EXTEN} at ${STRFTIME(${EPOCH},,%Y-%m-%d %H:%M:%S)}:${NL}${MESSAGE(body)}${NL}=====${NL})
same => n,TrySystem(python3 /usr/local/bin/notify.py sms_out --arg64 "${BASE64_ENCODE(${EXTEN})}" --arg64 "${BASE64_ENCODE(${BASE64_ENCODE(${MESSAGE(body)})})}" &)
same => n,Hangup()
same => n(send-failed),Hangup()
same => n(rebind-blocked),Hangup(41)
