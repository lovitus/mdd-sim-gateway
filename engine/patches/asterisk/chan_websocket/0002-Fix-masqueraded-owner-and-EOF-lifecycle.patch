+/* The core holds both channel locks while replacing a masqueraded channel. */
+static int webchan_fixup(struct ast_channel *oldchan, struct ast_channel *newchan)
+{
+	struct websocket_pvt *instance = ast_channel_tech_pvt(newchan);
