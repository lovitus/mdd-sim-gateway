# Offline/runtime-only migration from an explicitly trusted local Control image.
# Use only when control/requirements.txt and the base OS/tooling are unchanged. It refreshes
# application code and the already-reviewed WebUI build without downloading or compiling.
ARG BASE_IMAGE=mdd-sim-gateway/control-base:trusted
FROM ${BASE_IMAGE}

COPY control/app/ /app/control/app/
COPY control/run.py /app/control/run.py
COPY host/ /app/host/
COPY VERSION /app/VERSION
COPY webui/dist/ /app/webui/dist/

ARG RUNTIME_FP=""
LABEL io.mdd-sim-gateway.managed="true" \
      io.mdd-sim-gateway.control-runtime-fp="${RUNTIME_FP}" \
      org.opencontainers.image.title="MDD Sim Gateway control plane"

ENTRYPOINT ["/app/control/docker-entrypoint.sh"]
